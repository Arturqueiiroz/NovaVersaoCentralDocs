<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaVersaoCentralDocs.Views.DocumentoPage">

    <Grid RowDefinitions="Auto,*" BackgroundColor="White">
        <!-- TOPO -->
        <Grid Padding="10" HeightRequest="80">

            <!-- FUNDO COM GRADIENTE -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ffffff" Offset="0.0" />
                    <GradientStop Color="#3082D9" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- LAYOUT DO TOP BAR -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalOptions="Center">

                <!-- MENU AGORA FICA AQUI, NO COMEÇO -->
                <ImageButton 
            Grid.Column="0"
            Source="menu.png"
            WidthRequest="30"
            HeightRequest="30"
            BackgroundColor="Transparent"
            VerticalOptions="Center"
            HorizontalOptions="Start" />

                <!-- LOGO AO LADO DO MENU -->
                <Image
            Grid.Column="1"
            Source="logo.png"
            HeightRequest="200"
            Aspect="AspectFit"
            VerticalOptions="Center" />

                <!-- SEARCHBAR NO CENTRO -->
                <SearchBar
            Grid.Column="2"
            Placeholder="Digite o que você procura..."
            BackgroundColor="White"
            Margin="150,0"
            VerticalOptions="Center"
            HeightRequest="40"/>

            </Grid>
        </Grid>

        <!-- CONTEÚDO PRINCIPAL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="25">

                <!-- TÍTULO -->
                <Label 
                    Text="Seus Documentos"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#223145"
                    HorizontalOptions="Center"
                    Margin="0,10,0,20"/>

                <!-- BOTÕES DE DOCUMENTOS -->
                <Button Text="CARTEIRA DE IDENTIDADE NACIONAL"
                        ImageSource="icon_id.png"
                        BackgroundColor="#3082D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,20"/>

                <Button Text="E-TÍTULO"
                        ImageSource="icon_voto.png"
                        BackgroundColor="#3082D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,20"/>

                <Button Text="CNH"
                        ImageSource="icon_cnh.png"
                        BackgroundColor="#3082D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,20"/>

                <Button Text="CRLV"
                        ImageSource="icon_car.png"
                        BackgroundColor="#3082D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,20"/>

                <Button Text="PASSAPORTE"
                        ImageSource="icon_passaporte.png"
                        BackgroundColor="#3082D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="60"
                        HorizontalOptions="Fill"
                        ContentLayout="Left,20"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
