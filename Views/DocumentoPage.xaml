<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovaVersaoCentralDocs.Views.DocumentoPage">

    <Grid RowDefinitions="Auto,*" BackgroundColor="White">

        <!-- ========================================================= -->
        <!--                           TOPO                            -->
        <!-- ========================================================= -->
        <Grid Padding="10" HeightRequest="80">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#3082D9" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalOptions="Center">

                <ImageButton Grid.Column="0"
                             WidthRequest="30"
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             Source="menu.png"
                             Clicked="MenuPrincipla"/>

                <Image Grid.Column="1"
                       HeightRequest="200"
                       VerticalOptions="Center"
                       Aspect="AspectFit"
                       Source="logo.png"/>

                <SearchBar Grid.Column="2"
                           Placeholder="Digite o que você procura..."
                           BackgroundColor="White"
                           Margin="150,0"
                           HeightRequest="40"
                           VerticalOptions="Center"/>
            </Grid>
        </Grid>


        <!-- ========================================================= -->
        <!--                      CONTEÚDO                             -->
        <!-- ========================================================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="25">

                <Label Text="Seus Documentos"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#223145"
                       HorizontalOptions="Center"
                       Margin="0,10,0,20" />

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0"
                               Text="Carteira de Identidade Nacional"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E2A36"/>

                        <Label Grid.Row="1"
                               Text="Clique para ver seu documento"
                               FontSize="13"
                               TextColor="#7A8696"/>

                        <ImageButton Grid.Column="1"
                                     Grid.RowSpan="2"
                                     Source="icon_arrow.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="26"
                                     HeightRequest="26"/>
                    </Grid>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0"
                               Text="E-Título"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E2A36"/>

                        <Label Grid.Row="1"
                               Text="Clique para ver seu e-Título"
                               FontSize="13"
                               TextColor="#7A8696"/>

                        <ImageButton Grid.Column="1"
                                     Grid.RowSpan="2"
                                     Source="icon_arrow.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="26"
                                     HeightRequest="26" />
                    </Grid>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0"
                               Text="CNH"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E2A36"/>

                        <Label Grid.Row="1"
                               Text="Clique para acessar sua CNH"
                               FontSize="13"
                               TextColor="#7A8696"/>

                        <ImageButton Grid.Column="1"
                                     Grid.RowSpan="2"
                                     Source="icon_arrow.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="26"
                                     HeightRequest="26"/>
                    </Grid>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0"
                               Text="CRLV"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E2A36"/>

                        <Label Grid.Row="1"
                               Text="Documento do veículo"
                               FontSize="13"
                               TextColor="#7A8696"/>

                        <ImageButton Grid.Column="1"
                                     Grid.RowSpan="2"
                                     Source="icon_arrow.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="26"
                                     HeightRequest="26"/>
                    </Grid>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="18"
                       HasShadow="True">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0"
                               Text="Passaporte"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#1E2A36"/>

                        <Label Grid.Row="1"
                               Text="Clique para abrir seu passaporte"
                               FontSize="13"
                               TextColor="#7A8696"/>

                        <ImageButton Grid.Column="1"
                                     Grid.RowSpan="2"
                                     Source="icon_arrow.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="26"
                                     HeightRequest="26"/>
                    </Grid>
                </Frame>
                <Button Text="Voltar" Clicked="Voltar" BackgroundColor="#3082D9">
                    
                </Button>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
